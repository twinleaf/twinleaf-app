            { "path": "Sources/Twinleaf/BridgeSessionRegistry.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
            { "path": "Sources/Twinleaf/LoggingSession.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
            { "path": "Sources/Twinleaf/SignalGraphEditor.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
            { "path": "Sources/Twinleaf/SignalGraphTextView.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
            { "path": "Sources/Twinleaf/SignalGraphCanvas.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
            { "path": "Sources/Twinleaf/Tips.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
            { "path": "Sources/Twinleaf/SettingsSync.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
            { "path": "Sources/Twinleaf/BridgeClient.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
            { "path": "Sources/Twinleaf/RustRuntime.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
            {
              "path": "Sources/Twinleaf/LabcastSession.swift",
              "target-membership": [
                "Twinleaf/compile-sources",
                "TwinleafTests/compile-sources",
              ],
            }, {
              "kind": "group",
              "name": "Labcast",
              "children": [
                {
                  "path": "Sources/Twinleaf/Labcast/Publisher.swift",
                  "target-membership": [
                    "Twinleaf/compile-sources",
                    "TwinleafTests/compile-sources",
                  ],
                }, {
                  "path": "Sources/Twinleaf/Labcast/Subscriber.swift",
                  "target-membership": [
                    "Twinleaf/compile-sources",
