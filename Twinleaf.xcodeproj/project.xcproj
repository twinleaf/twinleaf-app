          "children": [
            { "path": "Tests/TwinleafTests/LabcastLoopbackTests.swift", "target-membership": [ "TwinleafTests/compile-sources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Packaging",
      "children": [
        { "path": "Packaging/Twinleaf-Info.plist" },
        { "path": "Packaging/TwinleafPad-Info.plist" },
        { "path": "Packaging/TwinleafPad.entitlements" },
        { "path": "Packaging/TwinleafQuickLook-Info.plist" },
        { "path": "Packaging/TwinleafQuickLook.entitlements" },
        { "path": "Packaging/TwinleafLiveActivity-Info.plist" },
      ],
    }, {
      "kind": "group",
      "name": "Scripts",
      "children": [
        { "path": "scripts/xcode-build-rust.sh" },
        { "path": "scripts/build-ios-rust.sh" },
      ],
    }, {
      "kind": "group",
      "name": "Rust",
      "children": [
        {
          "kind": "group",
          "name": "tio-bridge",
          "children": [
            { "path": "rust/tio-bridge/Cargo.toml" },
            { "path": "rust/Cargo.lock" },
            { "path": "rust/tio-bridge/include/twinleaf_core.h" },
            {
              "kind": "group",
              "name": "src",
              "children": [
                { "path": "rust/tio-bridge/src/lib.rs" },
                { "path": "rust/tio-bridge/src/main.rs" },
              ],
            },
          ],
        },
        { "path": "vendor/twinleaf-rust" },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Twinleaf.app", "id": "A00000000000000000000201", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TwinleafQuickLook.appex", "id": "A00000000000000000000203", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Twinleaf/copy/Embed Foundation Extensions", "platforms": [ "macos" ], "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/TwinleafLiveActivity.appex", "id": "A00000000000000000000204", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Twinleaf/copy/Embed Foundation Extensions", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/TwinleafTests.xctest", "id": "A00000000000000000000205", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Twinleaf",
      "id": "A00000000000000000000101",
      "product": "Products/Twinleaf.app",
      "product-type": "application",
      "dependencies": [
        { "target": "TwinleafQuickLook", "platforms": [ "macos" ] },
        { "target": "TwinleafLiveActivity", "platforms": [ "ios" ] },
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Build Rust Core",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "set -euo pipefail",
            "case \"${SDK_NAME:-}\" in",
            "\tmacosx*)",
            "\t\t\"${SRCROOT}/scripts/xcode-build-rust.sh\"",
            "\t\t;;",
            "\tiphoneos*|iphonesimulator*|xros*|xrsimulator*)",
            "\t\tIOS_RUST_MODE=staticlib \"${SRCROOT}/scripts/build-ios-rust.sh\" \"${CONFIGURATION}\"",
            "\t\t;;",
            "\t*)",
            "\t\techo \"error: unsupported SDK_NAME for Rust build: ${SDK_NAME:-unknown}\" >&2",
            "\t\texit 64",
            "\t\t;;",
            "esac",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*]": "Packaging/TwinleafPad.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]": "Packaging/TwinleafPad.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "Packaging/Twinleaf.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "3",
        "DEAD_CODE_STRIPPING": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Packaging/Twinleaf-Info.plist",
        "INFOPLIST_FILE[sdk=iphoneos*]": "Packaging/TwinleafPad-Info.plist",
        "INFOPLIST_FILE[sdk=iphonesimulator*]": "Packaging/TwinleafPad-Info.plist",
        "INFOPLIST_FILE[sdk=xros*]": "Packaging/TwinleafPad-Info.plist",
        "INFOPLIST_FILE[sdk=xrsimulator*]": "Packaging/TwinleafPad-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Twinleaf",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphoneos*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphonesimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xros*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xrsimulator*]": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LIBRARY_SEARCH_PATHS[sdk=iphoneos*]": [
          "$(inherited)",
          "$(BUILT_PRODUCTS_DIR)",
        ],
        "LIBRARY_SEARCH_PATHS[sdk=iphonesimulator*]": [
          "$(inherited)",
          "$(BUILT_PRODUCTS_DIR)",
        ],
        "LIBRARY_SEARCH_PATHS[sdk=xros*]": [
          "$(inherited)",
          "$(BUILT_PRODUCTS_DIR)",
        ],
        "LIBRARY_SEARCH_PATHS[sdk=xrsimulator*]": [
          "$(inherited)",
          "$(BUILT_PRODUCTS_DIR)",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.1",
        "OTHER_LDFLAGS[sdk=iphoneos*]": [
          "$(inherited)",
          "-ltwinleaf_core",
          "-framework",
          "IOKit",
          "-framework",
          "Security",
        ],
        "OTHER_LDFLAGS[sdk=iphonesimulator*]": [
          "$(inherited)",
          "-ltwinleaf_core",
          "-framework",
          "IOKit",
          "-framework",
          "Security",
        ],
        "OTHER_LDFLAGS[sdk=xros*]": [
          "$(inherited)",
          "-ltwinleaf_core",
          "-framework",
          "IOKit",
          "-framework",
          "Security",
        ],
        "OTHER_LDFLAGS[sdk=xrsimulator*]": [
          "$(inherited)",
          "-ltwinleaf_core",
          "-framework",
          "IOKit",
          "-framework",
          "Security",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twinleaf.Twinleaf",
        "PRODUCT_NAME": "Twinleaf",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug][sdk=iphoneos*]": "DEBUG TWINLEAF_STATIC_RUST",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug][sdk=iphonesimulator*]": "DEBUG TWINLEAF_STATIC_RUST",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug][sdk=xros*]": "DEBUG TWINLEAF_STATIC_RUST",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug][sdk=xrsimulator*]": "DEBUG TWINLEAF_STATIC_RUST",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Release][sdk=iphoneos*]": "TWINLEAF_STATIC_RUST",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Release][sdk=iphonesimulator*]": "TWINLEAF_STATIC_RUST",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Release][sdk=xros*]": "TWINLEAF_STATIC_RUST",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Release][sdk=xrsimulator*]": "TWINLEAF_STATIC_RUST",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "XROS_DEPLOYMENT_TARGET": "26.0",
      },
    }, {
      "name": "TwinleafQuickLook",
      "id": "A00000000000000000000103",
      "product": "Products/TwinleafQuickLook.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Packaging/TwinleafQuickLook.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "3",
        "DEAD_CODE_STRIPPING": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Packaging/TwinleafQuickLook-Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twinleaf.Twinleaf.QuickLook",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "TwinleafLiveActivity",
      "id": "A00000000000000000000104",
      "product": "Products/TwinleafLiveActivity.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "3",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Packaging/TwinleafLiveActivity-Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "1.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twinleaf.Twinleaf.LiveActivity",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SDKROOT": "iphoneos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "TwinleafTests",
      "id": "A00000000000000000000105",
      "product": "Products/TwinleafTests.xctest",
      "product-type": "bundle.unit-test",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "2",
        "DEAD_CODE_STRIPPING": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twinleaf.Twinleaf.Tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "macosx",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "6.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ARCHS": "arm64",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "6MFC6VKTVX",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
  "last-upgrade": "27.0",
