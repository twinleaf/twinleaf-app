    ],
  },
  "files": [
    { "path": "README.md" },
    {
      "kind": "group",
      "name": "Sources",
      "children": [
        {
          "kind": "group",
          "name": "Twinleaf",
          "children": [
            { "path": "Sources/Twinleaf/TwinleafApp.swift", "target-membership": [ "Twinleaf/compile-sources" ] },
