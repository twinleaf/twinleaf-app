                  ],
                }, {
                  "path": "Sources/Twinleaf/Labcast/Wire.swift",
                  "target-membership": [
                    "Twinleaf/compile-sources",
                    "TwinleafTests/compile-sources",
                  ],
                },
              ],
            }, {
              "kind": "group",
              "name": "Resources",
              "children": [
                { "path": "Sources/Twinleaf/Resources/Assets.xcassets", "target-membership": [ "Twinleaf/resources" ] },
                { "path": "Sources/Twinleaf/Resources/AppIcon.icon", "target-membership": [ "Twinleaf/resources" ] },
              ],
            },
          ],
        }, {
          "kind": "group",
          "name": "TwinleafQuickLook",
          "children": [
            { "path": "Sources/TwinleafQuickLook/PreviewProvider.swift", "target-membership": [ "TwinleafQuickLook/compile-sources" ] },
          ],
        }, {
